# ---------------------------------------------------------------------------
# Copy to .env and adjust. NEVER commit .env.
# ---------------------------------------------------------------------------

# Credentials used by `npm run admin:create` to seed the first admin account.
# The password is hashed with bcrypt before it is stored — this file is only
# read by the CLI script, never by the running app.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Hard cap for APK uploads, in megabytes.
MAX_APK_MB=100

# Where APKs and images live. Must stay OUTSIDE of public/.
DATA_DIR=./storage

# SQLite file. Defaults to $DATA_DIR/app.db
# DATABASE_PATH=./storage/app.db

# Public origin, used for canonical URLs. Empty = derive from the request host.
NEXT_PUBLIC_SITE_URL=
