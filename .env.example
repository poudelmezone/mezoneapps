# ---------------------------------------------------------------------------
# Copy to .env and adjust. NEVER commit .env.
# ---------------------------------------------------------------------------

# Credentials used by `npm run admin:create` (local) and, on serverless hosts,
# to create the first account automatically while the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave empty to use SQLite at storage/app.db (local dev, VPS, Docker).
# Set it to a Postgres connection string on Vercel/Neon/Supabase:
#   POSTGRES_URL=postgres://user:pass@host/db?sslmode=require
# DATABASE_URL is accepted as an alias.
POSTGRES_URL=

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# Leave empty to store APKs and images on local disk under DATA_DIR.
# On Vercel, create a Blob store (Storage -> Blob) and set:
#   BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Local storage (ignored when POSTGRES_URL is set)
# ---------------------------------------------------------------------------
# Hard cap for APK uploads, in megabytes.
MAX_APK_MB=100

# Where APKs and images live. Must stay OUTSIDE of public/.
DATA_DIR=./storage

# SQLite file. Defaults to $DATA_DIR/app.db
# DATABASE_PATH=./storage/app.db

# Public origin, used for canonical URLs. Empty = derive from the request host.
NEXT_PUBLIC_SITE_URL=
